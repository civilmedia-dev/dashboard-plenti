# Contraseña para entrar al dashboard (definila en Vercel, no acá)
DASHBOARD_PASSWORD=

# BigQuery
BIGQUERY_PROJECT_ID=civil-datalake
BIGQUERY_LOCATION=US

# Credenciales para Vercel (de la service account)
GCP_CLIENT_EMAIL=
GCP_PRIVATE_KEY=

# Alternativa solo para desarrollo local: ruta al JSON de la service account
# BIGQUERY_CREDENTIALS_PATH=./service-account.json

# Opcionales (tienen valores por defecto en src/server/config.ts)
